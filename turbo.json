{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "db:generate": {
      "cache": false,
      "outputs": ["apps/api/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["db:generate"]
    },
    "typecheck": {
      "dependsOn": ["db:generate"]
    },
    "test": {
      "dependsOn": ["db:generate"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
